# ---------------------------------------------------------------------------
# Grace New Designers — Laravel API
# Copy to .env and run `php artisan key:generate`. Never commit real secrets.
# ---------------------------------------------------------------------------
APP_NAME="Grace New Designers - Premium Menswear"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this API (used for media URLs when MEDIA_DISK=public).
APP_URL=http://localhost:8010
# Public storefront (Next.js). Used in password-reset links and as a fallback
# for product links in WhatsApp messages until "site_url" is set in admin settings.
FRONTEND_URL=http://localhost:3000
# Timestamps are stored in UTC; schedules and reports use this timezone.
OPERATIONS_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database (MySQL 8 in staging/production; SQLite is fine for local dev) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grace_new_designers
DB_USERNAME=gnd_app
DB_PASSWORD=
# DB_CONNECTION=sqlite   # local alternative: touch database/database.sqlite

# --- Sessions / Sanctum SPA authentication ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave null when the admin is served through the storefront's same-origin /backend proxy.
SESSION_DOMAIN=null
# Set true in production (HTTPS only).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Hosts (with port) of the storefront that may use cookie authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Comma-separated browser origins allowed by CORS (the storefront origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated or *).
TRUSTED_PROXIES=127.0.0.1

# --- Cache, queues (Redis recommended in production) ---
CACHE_STORE=database
# local dev may use `sync`; production should use `redis` (or `database`) with a worker:
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- File storage ---
FILESYSTEM_DISK=local
# Disk for uploaded media: `public` (local) or `s3` (any S3-compatible store).
MEDIA_DISK=public
# Generate AVIF renditions in addition to WebP (slower to encode).
MEDIA_AVIF=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (admin notifications, password resets) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storefront cache refresh after admin changes (must match frontend REVALIDATE_SECRET) ---
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=

# --- Seeding ---
# First owner account (required outside local; a dev password is generated locally if empty).
ADMIN_EMAIL=owner@example.com
ADMIN_NAME="Studio Owner"
ADMIN_PASSWORD=
# Seed the clearly-fictional demo catalogue outside the local environment (never in production).
SEED_DEMO=false
