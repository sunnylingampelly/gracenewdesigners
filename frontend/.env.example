# Public storefront origin (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API origin as reachable from the Next.js server (no trailing slash).
# Browser requests use same-origin rewrites (/backend/*), so this never needs to be public.
API_INTERNAL_URL=http://127.0.0.1:8010

# Seconds between background revalidations of catalogue pages (ISR).
CATALOG_REVALIDATE_SECONDS=60

# Shared secret for POST /api/revalidate (on-demand cache refresh after admin publishes).
REVALIDATE_SECRET=change-me
